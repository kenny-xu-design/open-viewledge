{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewledge.example/bridge/1.0/envelope.json",
  "title": "Viewledge Bridge API 1.0 response envelope",
  "description": "A public, implementation-independent envelope for approved Viewledge clients.",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "The public contract version, independent of private core releases."
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque identifier for support and retry correlation."
    },
    "data": {
      "type": ["object", "array", "null"],
      "description": "Endpoint-specific product data."
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "oneOf": [
    { "required": ["data"], "not": { "required": ["error"] } },
    { "required": ["error"], "not": { "required": ["data"] } }
  ],
  "additionalProperties": true,
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": ["object", "array", "null"] }
      },
      "additionalProperties": true
    }
  }
}
